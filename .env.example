# Supabase project URL (found in Project Settings → API)
SUPABASE_URL=

# Supabase anon/public key — NOT the service_role key
SUPABASE_ANON_KEY=

# Telegram bot username (without @) — used to build deep-links for auth and payment
BOT_USERNAME=

# Telegram bot token — used to send log messages to TELEGRAM_LOG_CHAT_ID
TELEGRAM_BOT_TOKEN=

# Telegram chat/channel ID that receives bot log exports (e.g. your own chat ID)
TELEGRAM_LOG_CHAT_ID=

# KRW subscription price shown in the UI — must match SUBSCRIPTION_PRICE_KRW in authbot/.env
SUBSCRIPTION_PRICE_KRW=9900
