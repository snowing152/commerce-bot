{
  "name": "coupang-bot",
  "version": "2.0.2",
  "main": "out/main/index.js",
  "scripts": {
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('out', { recursive: true, force: true }); fs.rmSync('release', { recursive: true, force: true });\"",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron .",
    "pack": "npm run clean && electron-vite build && electron-builder --win --x64",
    "test": "jest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.100.1",
    "dotenv": "^17.3.1",
    "electron-store": "^7.0.3",
    "electron-updater": "^6.8.3",
    "node-telegram-bot-api": "^0.63.0",
    "patchright": "^1.58.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/node-telegram-bot-api": "^0.64.14",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.2.1",
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "jest": "^30.3.0",
    "tailwindcss": "^4.1.7",
    "ts-jest": "^29.4.6",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.coupang.bot",
    "productName": "Coupang Bot",
    "artifactName": "Coupang-Bot-Setup-${version}.${ext}",
    "asar": true,
    "directories": {
      "output": "release/"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "snowing152",
        "repo": "commerce-bot"
      }
    ],
    "compression": "maximum",
    "files": [
      "out/**/*",
      "config/**/*"
    ]
  }
}
